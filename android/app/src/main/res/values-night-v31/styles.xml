<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ owns the native icon splash; full official art is in Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">#EAB124</item>
        <item name="android:statusBarColor">#EAB124</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#EAB124</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
